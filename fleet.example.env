# Copy to ~/.config/tesla-fleet-voice/fleet.env and `chmod 600` it. Never commit the real file.
# Environment variables with the same names override these.

# From your app on developer.tesla.com
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# The domain that serves your public key and the OAuth callback (registered with Tesla)
APP_DOMAIN=example.com
# Optional; default https://<APP_DOMAIN>/tesla/oauth/callback
REDIRECT_URI=
# ssh alias of the web server running server/oauth_callback.py (setup only)
CALLBACK_SSH_HOST=

# Fleet API region host. North America shown; see Tesla's docs for Europe / Asia-Pacific.
FLEET_HOST=fleet-api.prd.na.vn.cloud.tesla.com

# Which car, if the account has more than one (its display name in the Tesla app)
CAR_DISPLAY_NAME=
# How spoken sentences refer to it
CAR_SPOKEN_NAME=the car

# car_service: a long random string shared with car.py and any phone client
SERVICE_TOKEN=
SERVICE_PORT=7795
# Comma-separated CIDRs allowed besides loopback: your home LAN and VPN subnets
ALLOWED_NETS=

# Map search for "navigate to <place>": a point near home, used only to rank results.
# Example below is a public landmark (Empire State Building), not anyone's home.
HOME_LAT=40.7484
HOME_LON=-73.9857
MAP_COUNTRY=us

# Optional: a voice daemon endpoint that speaks {"text": "..."} (POST)
SAY_URL=
# Optional: Pushover alerts from the watchdog
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Path to tesla-control (built from github.com/teslamotors/vehicle-command)
TESLA_CONTROL=~/.local/bin/tesla-control
